import fs from "node:fs";
import path from "node:path";

import { registry } from "../registry/index.js";

const REGISTRY_PATH = path.join(process.cwd(), "src/__registry__");

async function buildRegistry() {
  if (!fs.existsSync(REGISTRY_PATH)) {
    fs.mkdirSync(REGISTRY_PATH, { recursive: true });
  }

  // 1. Generate registry.autogenerated.json
  const jsonPath = path.join(REGISTRY_PATH, "registry.autogenerated.json");
  fs.writeFileSync(jsonPath, JSON.stringify(registry, null, 2), "utf8");

  // 2. Generate index.tsx
  let indexContent = `/* eslint-disable @typescript-eslint/ban-ts-comment */
/* eslint-disable @typescript-eslint/no-explicit-any */
// @ts-nocheck
// This file is autogenerated by scripts/build-registry.mts
// Do not edit this file directly.

import React from "react";

export const Index: Record<string, any> = {
`;

  for (const item of registry.items) {
    const files = item.files?.map((file) => {
      const filePath = typeof file === "string" ? file : file.path;
      const fileType = typeof file === "string" ? item.type : file.type;
      const fullPath = filePath.startsWith("src/registry/")
        ? filePath
        : `src/registry/${filePath}`;
      return `    {\n      path: "${fullPath}",\n      type: "${fileType}",\n    }`;
    });

    const isExample = item.type === "registry:example";
    const exampleFile = item.files?.[0];
    const exampleFilePath = typeof exampleFile === "string" ? exampleFile : exampleFile?.path;

    indexContent += `  "${item.name}": {
    name: "${item.name}",
    description: "${item.description?.replace(/"/g, '\\"') || ""}",
    type: "${item.type}",
    files: [${files ? "\n" + files.join(",\n") + "\n  " : ""}],
${isExample && exampleFilePath ? `    component: React.lazy(() => import("@/registry/${exampleFilePath}")),\n` : ""}  },\n`;
  }

  indexContent += "};\n";

  const indexPath = path.join(REGISTRY_PATH, "index.tsx");
  fs.writeFileSync(indexPath, indexContent, "utf8");

  console.log("Registry build complete: src/__registry__/index.tsx generated successfully.");
}

buildRegistry().catch(console.error);

